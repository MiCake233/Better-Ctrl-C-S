#ifndef RT_MANIFEST
#define RT_MANIFEST 24
#endif
#include "../src/resource.h"

IDI_APP ICON "resources/app.ico"

1 RT_MANIFEST "resources/app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiCake233"
            VALUE "FileDescription", "Better Ctrl+C/S"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "BetterCtrlCS"
            VALUE "LegalCopyright", "Copyright (c) 2026 MiCake233. MIT License."
            VALUE "OriginalFilename", "BetterCtrlCS.exe"
            VALUE "ProductName", "Better Ctrl+C/S"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
